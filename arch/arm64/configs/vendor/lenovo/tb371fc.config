# Lenovo Xiaoxin Pad Pro 12.7 2023 (TB371FC)
# Used on top of vendor/kona-perf_defconfig and vendor/debugfs.config.

# DTBO
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Backlight: two KTZ8866 (ktz,ktz8866a / ktz,ktz8866b), driven by the
# display's bl_ctrl_external path
CONFIG_BACKLIGHT_KTZ8866=y
CONFIG_BACKLIGHT_DUALKTZ8866=y

# Charger: stock enables the SMB1398 charge pump
CONFIG_SMB1398_CHARGER=y

# DebugFS
CONFIG_DEBUG_FS=n
CONFIG_MSM_TZ_LOG=n
CONFIG_CMA_DEBUGFS=n
CONFIG_REGMAP_ALLOW_WRITE_DEBUGFS=n
CONFIG_IPA_UT=n
CONFIG_IOMMU_TESTS=n
CONFIG_QMP_DEBUGFS_CLIENT=n

# Filesystems
CONFIG_EXFAT_FS=y
CONFIG_EROFS_FS=y

# Keyboard folio (hid-over-i2c)
CONFIG_I2C_HID=y

# Persistent store, so a crashing boot leaves a log
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
# No ramoops_memreserve: its fixed 0xb0000000 is bootlog_mem (cnss) here.
CONFIG_CMDLINE="cgroup_disable=pressure"

# QCACLD (built in; stock loads qca_cld3_qca6390.ko)
CONFIG_QCA_CLD_WLAN=y
CONFIG_QCA_CLD_WLAN_PROFILE="qca6390"

# Regulator
CONFIG_I2C_RETRY=y
CONFIG_REGULATOR_PM8008=y
CONFIG_REGULATOR_QCOM_RPMH=y

# Touchscreen: Novatek NT36532 over SPI (novatek,NVT-ts-spi)
CONFIG_TOUCHSCREEN_NT36532_HOSTDL_SPI=y
CONFIG_TOUCHSCREEN_FTS=n
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX=n
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM=n
CONFIG_TOUCHSCREEN_ST=n

# USB: dwc3-msm calls into the PS5169 redriver driver
CONFIG_PS5169=y

# Vibrator: none
CONFIG_INPUT_QTI_HAPTICS=n

# Bring-up: log CFI violations instead of panicking (remove once clean)
CONFIG_CFI_PERMISSIVE=y

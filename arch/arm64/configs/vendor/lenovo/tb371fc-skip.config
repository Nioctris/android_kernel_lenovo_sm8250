# Bring-up: skip late initcalls through initcall_blacklist=. The built-in
# cmdline is appended to the bootloader's (CMDLINE_EXTEND), so it doesn't
# count against the 512-byte boot header field. Needs KALLSYMS and no
# LTO/CFI symbol renaming.
#
# ipa_mpm_init: hangs the board in late init (~1.4 s). qcom,ipa-mpm is enabled
# in the stock DT while the IPA core (qcom,ipa) is disabled on this
# Wi-Fi-only tablet. Found by bisecting the 1045-1064 late initcalls.
#
# No ramoops_memreserve: 0xb0000000 is taken on this board (bootlog_mem);
# dtb-debug carries a ramoops node instead.
CONFIG_CMDLINE="cgroup_disable=pressure initcall_blacklist=ipa_mpm_init"

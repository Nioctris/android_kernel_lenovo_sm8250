# Bring-up only: framebuffer console bits (unused since simplefb never drew)
# and reboot on panic.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_SUN12x22=y
# Reboot (warm, reboot=panic_warm) 5 s after a panic so ramoops keeps the log.
CONFIG_PANIC_TIMEOUT=5
CONFIG_LOGO=n

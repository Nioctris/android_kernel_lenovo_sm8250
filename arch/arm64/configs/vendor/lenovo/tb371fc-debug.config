# Bring-up only: print the kernel log on the bootloader's splash framebuffer
# (needs the debug DTB with a simple-framebuffer node) and stop on panic.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_SUN12x22=y
CONFIG_PANIC_TIMEOUT=0
CONFIG_LOGO=n

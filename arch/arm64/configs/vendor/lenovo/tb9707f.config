# Lenovo Legion Y700 (2022) on top of vendor/kona-perf_defconfig.
CONFIG_LOCALVERSION="-tb9707f"
# CONFIG_LOCALVERSION_AUTO is not set

# Match the stock non-LTO image and avoid carrying unused Xiaomi touch drivers.
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_TOUCHSCREEN_FTS is not set
# CONFIG_TOUCHSCREEN_NT36523_HOSTDL_SPI is not set
CONFIG_TOUCHSCREEN_NT36532_HOSTDL_SPI=y

CONFIG_BUILD_ARM64_DT_OVERLAY=y
CONFIG_BACKLIGHT_KTZ8866_TB9707F=y
CONFIG_SND_SOC_CS35L45_I2C=y
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y
# CONFIG_BATTERY_BQ27XXX_DT_UPDATES_NVM is not set
CONFIG_QCA_CLD_WLAN=y
CONFIG_QCA_CLD_WLAN_PROFILE="qca6390"

# Stock charger stack: PM8150B (SMB5, FG Gen4) and the SMB1396 charge pumps.
CONFIG_QPNP_SMB5=y
CONFIG_QPNP_FG_GEN4=y
CONFIG_MFD_I2C_PMIC=y
CONFIG_SMB1398_CHARGER=y
# CONFIG_SMB1390_CHARGE_PUMP_PSY is not set
# CONFIG_SMB1355_SLAVE_CHARGER is not set
# CONFIG_QPNP_QNOVO5 is not set

# devtmpfs and USB ACM for the U-Boot RAM test (device tools/ram-test).
CONFIG_DEVTMPFS=y
CONFIG_USB_CONFIGFS_ACM=y

# Vibration: two AW8697 on I2C; nothing is wired to the PM8150B haptics,
# which the vibrator HAL would otherwise pick.
# CONFIG_INPUT_QTI_HAPTICS is not set
CONFIG_INPUT_AW86927_HAPTIC=y
CONFIG_INPUT_GAME_MODE_SWITCHER=y

# Hardware the TB-9707F does not have: NFC, the Xiaomi PS5169 redriver
# (it uses ON Semi redrivers), ST and Synaptics touch controllers.
# CONFIG_NFC_NQ is not set
# CONFIG_TOUCHSCREEN_ST is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM is not set

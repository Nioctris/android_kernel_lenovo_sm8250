# Bring-up: shrink the kernel image toward the stock size (image_size
# 0x2ab4000). Lenovo's ABL appears unable to start a much larger kernel.
CONFIG_LTO_CLANG=n
CONFIG_LTO_NONE=y
CONFIG_THINLTO=n
CONFIG_CFI_CLANG=n
CONFIG_KALLSYMS_ALL=n
CONFIG_TECHPACK_CAMERA_NONE=y
CONFIG_MSM_NPU=n
CONFIG_QCA_CLD_WLAN=n
CONFIG_IKHEADERS=n
